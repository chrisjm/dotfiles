[init]
	defaultBranch = main

# Include local file that shouldn't be replicated between servers
[include]
  path = ~/.gitconfig.local

[commit]
	verbose = true

[diff]
  colorMoved = default

[push]
	default = simple
	autoSetupRemote = true

[pull]
	rebase = false
	ff = only

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[merge]
	conflictstyle = zdiff3

[user]
	name = Chris J Mears
	email = chris.mears@gmail.com

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
