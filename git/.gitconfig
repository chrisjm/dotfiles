[init]
	defaultBranch = main

# Include local file that shouldn't be replicated between servers
[include]
  path = ~/.gitconfig.local

[commit]
	verbose = true

[diff]
  colorMoved = default

[push]
	default = simple
	autoSetupRemote = true

[pull]
	rebase = false
	ff = only

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[user]
	name = Chris J Mears
	email = chris.mears@gmail.com
